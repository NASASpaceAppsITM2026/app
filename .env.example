# Groq API key for the AI mission assistant.
# Get a free key at https://console.groq.com/keys
# Copy this file to .env at the repo root (lunar-navigator-app/.env) and fill in your key.
# Restart the Vite dev server after changing this file.
# .env is gitignored — never commit real keys.
#
# Note: VITE_ variables are inlined into the browser bundle. Fine for local
# development; do not ship a production build with a real key in this file.
VITE_GROQ_API_KEY=your_groq_api_key_here
# Optional override. Default is openai/gpt-oss-120b (llama-3.3-70b-versatile
# was retired for Groq free/developer tiers on 2026-08-16).
# VITE_GROQ_MODEL=openai/gpt-oss-120b
